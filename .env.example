# LLM provider configuration is intentionally optional in v0.1.
# The starter graph runs with deterministic demo analysts.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Runtime
TRADEPILOT_INITIAL_CAPITAL=500
TRADEPILOT_MAX_ANALYSIS_ROUNDS=3
TRADEPILOT_MAX_RISK_PER_TRADE=0.01
TRADEPILOT_MAX_POSITION_FRACTION=0.50
TRADEPILOT_MODE=paper
TRADEPILOT_MEMORY_DB=data/tradepilot.sqlite3
